import tkinter as tk
from tkinter import ttk
import json

players = []
events = []
positions = []

def save_data():
    data = {"players": players, "events": events, "positions": positions}
    with open("data.json", "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=4)

def load_data():
    global players
    global events
    global positions

    try:
        with open("data.json", "r", encoding="utf-8") as f:
            data = json.load(f)
            players = data.get("players", [])
            events = data.get("events", [])
            positions = data.get("positions", [])

    except FileNotFoundError:
        players = []
        events = []
        positions = []

def add_player():
    name = player_name_entry.get()
    p_type = player_type_box.get()
    if name == "":
        return
    player = {"name": name,"type": p_type}
    players.append(player)

    player_listbox.insert(tk.END, f"{name} ({p_type})")
    player_name_entry.delete(0, tk.END)
    update_all_comboboxes()

def delete_player():
    selected = player_listbox.curselection()
    if not selected:
        return
    index = selected[0]
    del players[index]
    player_listbox.delete(index)
    update_all_comboboxes()

selected_player_index = None

def load_player():
    global selected_player_index
    selected = player_listbox.curselection()
    if not selected:
        return
    index = selected[0]
    player = players[index]
    player_name_entry.delete(0, tk.END)
    player_name_entry.insert(0, player["name"])
    player_type_box.set(player["type"])
    selected_player_index = index

def update_player():
    global selected_player_index
    if selected_player_index is None:
        return
    name = player_name_entry.get()
    p_type = player_type_box.get()
    if name == "":
        return
    players[selected_player_index] = {"name": name,"type": p_type}
    player_listbox.delete(selected_player_index)
    player_listbox.insert(selected_player_index,f"{name} ({p_type})")
    player_name_entry.delete(0, tk.END)
    player_type_box.current(0)
    selected_player_index = None
    update_all_comboboxes()

def add_event():
    event_name = event_name_entry.get()
    if event_name == "":
        return
    event = {"name": event_name,"players": []}
    events.append(event)
    event_listbox.insert(tk.END, event_name)
    event_name_entry.delete(0, tk.END)
    update_all_comboboxes()

def update_all_comboboxes():
    event_names = []
    for e in events:event_names.append(e["name"])
    player_names = []
    for p in players:player_names.append(p["name"])
    select_event_box["values"] = event_names
    position_event_box["values"] = event_names
    score_event_box["values"] = event_names
    select_player_box["values"] = player_names

def add_player_to_event():
    event_name = select_event_box.get()
    player_name = select_player_box.get()
    if event_name == "" or player_name == "":
        return
    for e in events:
        if e["name"] == event_name:
            if player_name not in e["players"]:
                e["players"].append(player_name)
    show_event_players()

def show_event_players(event=None):
    event_players_listbox.delete(0, tk.END)
    event_name = select_event_box.get()
    for e in events:
        if e["name"] == event_name:
            for p in e["players"]:
                event_players_listbox.insert(tk.END, p)

def update_position_players(event=None):
    event_name = position_event_box.get()
    for e in events:
        if e["name"] == event_name:
            position_player_box["values"] = e["players"]

def save_position():
    event_name = position_event_box.get()
    player_name = position_player_box.get()
    position = position_entry.get()
    if position == "":
        return
    data = {"event": event_name,"player": player_name,"position": int(position)}
    positions.append(data)
    position_entry.delete(0, tk.END)
    show_positions()

def show_positions():
    position_listbox.delete(0, tk.END)
    event_name = position_event_box.get()
    for p in positions:
        if p["event"] == event_name:
            text = f"{p['player']} - {p['position']} place"
            position_listbox.insert(tk.END, text)

def save_score():
    event_name = score_event_box.get()
    position = score_position_entry.get()
    points = score_points_entry.get()
    if event_name == "":
        return
    if position == "":
        return
    if points == "":
        return
    for e in events:
        if e["name"] == event_name:
            if "points" not in e:
                e["points"] = {}
            e["points"][int(position)] = int(points)
    score_position_entry.delete(0, tk.END)
    score_points_entry.delete(0, tk.END)

def show_results():
    result_text.delete("1.0", tk.END)
    for event in events:
        event_name = event["name"]
        result_text.insert(tk.END,f"\n=== {event_name} ===\n")
        totals = {}
        for p in positions:
            if p["event"] != event_name:
                continue
            player = p["player"]
            pos = p["position"]
            points = event.get("points", {}).get(pos, 0)
            if player not in totals:totals[player] = {"points": 0,"position": pos}
            totals[player]["points"] += points
        ranking = sorted(totals.items(), key=lambda x: x[1]["points"], reverse=True)
        rank = 1
        for player, data in ranking:
            text = (f"{rank}. "f"{player} | "f"{data['points']} pts | "f"{data['position']} place\n")
            result_text.insert(tk.END, text)
            rank += 1

root = tk.Tk()
root.title("Tournament Manager")
root.geometry("900x700")

notebook = ttk.Notebook(root)
notebook.pack(fill="both", expand=True)

player_tab = tk.Frame(notebook)
notebook.add(player_tab, text="Add Player")

tk.Label(player_tab, text="Player Name").pack()
player_name_entry = tk.Entry(player_tab)
player_name_entry.pack(pady=5)
tk.Label(player_tab, text="Player Type").pack()
player_type_box = ttk.Combobox(player_tab, values=["Individual", "Team"], state="readonly")
player_type_box.pack(pady=5)
player_type_box.current(0)
tk.Button(player_tab, text="Add Player", command=add_player).pack(pady=5)
tk.Button(player_tab, text="Delete Player", command=delete_player).pack(pady=5)
tk.Button(player_tab, text="Load Selected", command=load_player).pack(pady=5)
tk.Button(player_tab, text="Update Player", command=update_player).pack(pady=5)
tk.Button(player_tab, text="Update Player", command=update_player).pack(pady=5)
player_listbox = tk.Listbox(player_tab, width=40, height=10)
player_listbox.pack(pady=10)

event_tab = tk.Frame(notebook)
notebook.add(event_tab, text="Add Event")
tk.Label(event_tab, text="Event Name").pack()
event_name_entry = tk.Entry(event_tab)
event_name_entry.pack(pady=5)

tk.Button(event_tab, text="Create Event", command=add_event).pack(pady=5)

event_listbox = tk.Listbox(event_tab, height=10)
event_listbox.pack(pady=10)
select_tab = tk.Frame(notebook)
notebook.add(select_tab, text="Select Event")
select_event_box = ttk.Combobox(select_tab, state="readonly")
select_event_box.pack(pady=5)
select_event_box.bind("<<ComboboxSelected>>", show_event_players)
select_player_box = ttk.Combobox(select_tab, state="readonly")
select_player_box.pack(pady=5)
tk.Button(select_tab, text="Add Player To Event", command=add_player_to_event).pack(pady=5)
event_players_listbox = tk.Listbox(select_tab, height=10)
event_players_listbox.pack(pady=10)
# Add position system
position_tab = tk.Frame(notebook)
notebook.add(position_tab, text="Add Position")
position_event_box = ttk.Combobox(position_tab, state="readonly")
position_event_box.pack(pady=5)
position_event_box.bind("<<ComboboxSelected>>", update_position_players)
position_player_box = ttk.Combobox(position_tab, state="readonly")
position_player_box.pack(pady=5)
tk.Label(position_tab, text="Position").pack()
position_entry = tk.Entry(position_tab)
position_entry.pack(pady=5)
tk.Button(position_tab, text="Save Position", command=save_position).pack(pady=5)
position_listbox = tk.Listbox(position_tab, height=10)
position_listbox.pack(pady=10)
# add score tab
score_tab = tk.Frame(notebook)
notebook.add(score_tab, text="Add Score")
score_event_box = ttk.Combobox(score_tab, state="readonly")
score_event_box.pack(pady=5)
tk.Label(score_tab, text="Position").pack()
score_position_entry = tk.Entry(score_tab)
score_position_entry.pack(pady=5)

tk.Label(score_tab, text="Points").pack()
score_points_entry = tk.Entry(score_tab)
score_points_entry.pack(pady=5)
tk.Button(score_tab, text="Save Score", command=save_score).pack(pady=5)
# Result tab
result_tab = tk.Frame(notebook)
notebook.add(result_tab, text="Results")
result_text = tk.Text(result_tab, width=70, height=25)
result_text.pack(pady=10)
tk.Button(result_tab, text="Refresh Results", command=show_results).pack(pady=5)

tk.Button(root, text="Save Data", command=save_data).pack(pady=10)

load_data()

for p in players:
    text = f"{p['name']} ({p['type']})"
    player_listbox.insert(tk.END, text)
for e in events:
    event_listbox.insert(tk.END, e["name"])
update_all_comboboxes()

root.mainloop()